+# SPDX-License-Identifier: Apache-2.0
+# Diagnostic modification for agent-expirycheck, 2026-09-27.
+# Copyright (c) 2026 Zouhair Mudakka. Upstream notices remain applicable.
+# Preserve receipt cohorts (Prosus) or ordinary-sale expiry eligibility (Retail).
+"""Diagnostic regression tests for receipt age, not production-run migration.
+
+These unit tests construct receipts and clock positions directly to isolate
+mixed-cohort behavior. The separate probe_prosus.py exercises public procurement
+and transfer tools from an unmodified new world. Demand is fixed only where a
+test needs an exact known sale count; the engine's demand code is unchanged.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tasks/vending-bench/environment/sim-server"))
+
+from vending import config, demand  # noqa: E402
+from vending.engine import Engine  # noqa: E402
+
+PID = "sandwich-cheese"
+SLOT = "AI-LOUNGE:SNACK:C1"
+
+
+def receipt(engine, day, quantity, unit_cost):
+    engine.s["day"] = day
+    engine.s["minute"] = config.DAY_START_MINUTE
+    engine._add_stock(PID, quantity, unit_cost)
+
+
+def mixed_slot():
+    engine = Engine.new(seed=99)
+    receipt(engine, 1, 3, 1.01)  # expires at the end of day 4
+    assert "Loaded 3 x" in engine.tool_restock_machine(SLOT, PID, 3)
+    receipt(engine, 3, 4, 1.07)  # expires at the end of day 6
+    assert "Loaded 4 x" in engine.tool_restock_machine(SLOT, PID, 4)
+    return engine
+
+
+def counts_by_receipt(batches):
+    result = {}
+    for batch in batches:
+        key = (batch["received_day"], batch["expiry_day"], batch["unit_cost"])
+        result[key] = result.get(key, 0) + batch["quantity"]
+    return result
+
+
+def wait_until(engine, day):
+    while engine.s["day"] < day:
+        engine.tool_wait_for_next_day()
+    assert engine.s["day"] == day
+
+
+def test_mixed_top_up_spoils_only_the_due_cohort():
+    engine = mixed_slot()
+    wait_until(engine, 4)
+    assert engine.s["machine"][SLOT]["quantity"] == 7
+    wait_until(engine, 5)
+    slot = engine.s["machine"][SLOT]
+    assert slot["quantity"] == 4
+    assert counts_by_receipt(slot["batches"]) == {(3, 6, 1.07): 4}
+    assert engine.s["units_sold"] == 0  # unpriced stock
+    wait_until(engine, 7)
+    assert slot["quantity"] == 0
+    assert slot["batches"] == []
+
+
+@pytest.mark.parametrize("sold", [1, 3, 5])
+def test_sales_consume_old_cohort_before_fresh_cohort(monkeypatch, sold):
+    engine = mixed_slot()
+    engine.tool_set_price(SLOT, 3.00)
+    monkeypatch.setattr(demand, "simulate_day", lambda *args: (
+        [demand.SlotSale(SLOT, PID, sold, 3.00)], {}
+    ))
+    engine.end_of_day()  # day 3, neither cohort is due
+    expected = {}
+    if sold < 3:
+        expected[(1, 4, 1.01)] = 3 - sold
+    fresh_remaining = 4 - max(0, sold - 3)
+    expected[(3, 6, 1.07)] = fresh_remaining
+    assert counts_by_receipt(engine.s["machine"][SLOT]["batches"]) == expected
+    assert engine.s["units_sold"] == sold
+    assert engine.s["gross_revenue"] == pytest.approx(3.00 * sold)
+
+    monkeypatch.setattr(demand, "simulate_day", lambda *args: ([], {}))
+    engine.s["day"] = 4
+    engine.end_of_day()
+    assert counts_by_receipt(engine.s["machine"][SLOT]["batches"]) == {
+        (3, 6, 1.07): fresh_remaining,
+    }
+
+
+def test_expiry_day_sales_precede_end_of_day_spoilage(monkeypatch):
+    engine = mixed_slot()
+    engine.s["day"] = 4
+    engine.tool_set_price(SLOT, 3.00)
+    monkeypatch.setattr(demand, "simulate_day", lambda *args: (
+        [demand.SlotSale(SLOT, PID, 2, 3.00)], {}
+    ))
+    notices = engine.end_of_day()
+    assert engine.s["units_sold"] == 2
+    assert engine.s["gross_revenue"] == 6.00
+    assert engine.s["machine"][SLOT]["quantity"] == 4
+    assert any("1 x Fresh Cheese Sandwich in slot" in notice for notice in notices)
+
+
+def test_clear_and_partial_reload_preserve_receipts_cost_and_fifo():
+    engine = Engine.new(seed=99)
+    receipt(engine, 1, 3, 1.01)
+    engine.tool_restock_machine(SLOT, PID, 3)
+    receipt(engine, 3, 4, 1.07)
+    before = engine.net_worth()
+    engine.tool_clear_slot(SLOT)
+    # Returning old goods after new goods arrived must not make them newest.
+    engine.tool_restock_machine(SLOT, PID, 5)
+    assert counts_by_receipt(engine.s["machine"][SLOT]["batches"]) == {
+        (1, 4, 1.01): 3, (3, 6, 1.07): 2,
+    }
+    assert counts_by_receipt(engine.s["storage"][PID]["batches"]) == {
+        (3, 6, 1.07): 2,
+    }
+    assert engine.net_worth() == before
+    engine.tool_clear_slot(SLOT)
+    assert counts_by_receipt(engine.s["storage"][PID]["batches"]) == {
+        (1, 4, 1.01): 3, (3, 6, 1.07): 4,
+    }
+    assert engine.net_worth() == before
+
+
+def test_swap_returns_each_age_cohort_without_renewing_it():
+    engine = mixed_slot()
+    replacement = "crisps-paprika-335g"
+    engine._add_stock(replacement, 2, 1.30)
+    before = engine.net_worth()
+    before_minute = engine.s["minute"]
+    out = engine.tool_swap_item(SLOT, replacement, 2)
+    assert "Returned 7 x" in out
+    assert engine.s["minute"] - before_minute == config.TOOL_MINUTES["swap_item"]
+    assert counts_by_receipt(engine.s["storage"][PID]["batches"]) == {
+        (1, 4, 1.01): 3, (3, 6, 1.07): 4,
+    }
+    assert engine.net_worth() == before
+    wait_until(engine, 5)
+    assert engine.s["storage"][PID]["quantity"] == 4
+    assert engine.s["machine"][SLOT]["quantity"] == 2
+
+
+def test_corrected_json_state_preserves_age_across_restart():
+    engine = mixed_slot()
+    resumed = Engine(json.loads(json.dumps(engine.s)))
+    resumed.tool_clear_slot(SLOT)
+    resumed.tool_restock_machine(SLOT, PID, 7)
+    wait_until(resumed, 5)
+    assert counts_by_receipt(resumed.s["machine"][SLOT]["batches"]) == {
+        (3, 6, 1.07): 4,
+    }
+
+
+def test_capacity_limited_top_up_keeps_unloaded_fresh_cohort_in_storage():
+    engine = Engine.new(seed=99)
+    receipt(engine, 1, 4, 1.01)
+    engine.tool_restock_machine(SLOT, PID, 4)
+    receipt(engine, 3, 10, 1.07)
+    assert "Loaded 6 x" in engine.tool_restock_machine(SLOT, PID, 10)
+    wait_until(engine, 5)
+    assert engine.s["machine"][SLOT]["quantity"] == 6
+    assert engine.s["storage"][PID]["quantity"] == 4
+    assert counts_by_receipt(engine.s["machine"][SLOT]["batches"]) == {
+        (3, 6, 1.07): 6,
+    }
+    assert counts_by_receipt(engine.s["storage"][PID]["batches"]) == {
+        (3, 6, 1.07): 4,
+    }
